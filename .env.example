# Get one at https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key-here

# Bearer token to authenticate requests to the MCP (you make this up).
# Use the same value in the Authorization header of your MCP client.
# Generate a strong one: openssl rand -hex 32
MCP_BEARER_TOKEN=paste-a-random-token-here

# Dev-only escape hatch. Set to exactly "true" to run WITHOUT auth when
# MCP_BEARER_TOKEN is unset. NEVER set this in production — the server is
# fail-closed by design and will return 503 if the token is missing.
# MCP_ALLOW_NO_AUTH=true

# Optional: maximum USD a single session can spend before requests are rejected.
# Protects against runaway spend if your bearer token is leaked.
# MAX_SESSION_USD=5.00
